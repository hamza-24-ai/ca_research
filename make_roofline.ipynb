# Roofline plots for CPU, GPU (T4) and TPU (v5e-1).
# Data = measured values from Task 2 CSV files (matmul_*.csv, bandwidth_*.csv).
# Arithmetic intensity (AI) for square matmul, FP32: FLOPs = 2n^3, bytes = 3*n^2*4 -> AI = n/6.
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

sizes = [256, 512, 1024, 1536, 2048]
ai = [n / 6 for n in sizes]                    # FLOP/byte

devices = {
    "CPU (Xeon, 1 core)": {
        "achieved": [31.85, 28.95, 37.02, 64.45, 64.67],     # GFLOPS, median
        "peak_compute": 70.4,                                # GFLOPS (Task 1, 2.2 GHz x 32)
        "bw_measured": 10.05,                                # GB/s, copy 800 MB
        "bw_label": "measured copy 10.1 GB/s",
        "bw_ref": None,
        "fname": "Roofline_CPU.png",
        "note": "Peak = 1 core, nominal 2.2 GHz (Task 1).",
    },
    "GPU (NVIDIA T4)": {
        "achieved": [593.2, 2253.1, 3336.2, 3513.9, 3596.0],
        "peak_compute": 8140.8,                              # GFLOPS FP32 (Task 1)
        "bw_measured": 241.1,                                # GB/s, copy 800 MB
        "bw_label": "measured copy 241 GB/s",
        "bw_ref": 300.0,                                     # datasheet
        "fname": "Roofline_GPU.png",
        "note": "Peak = FP32 CUDA cores, boost 1.59 GHz.",
    },
    "TPU (v5e-1)": {
        "achieved": [66.7, 651.0, 4801.6, 15014.4, 30570.3],
        "peak_compute": 197000.0,                            # GFLOPS bf16 (Google published)
        "bw_measured": 246.1,                                # GB/s, scale_add 800 MB
        "bw_label": "measured scale_add 246 GB/s",
        "bw_ref": 819.0,                                     # Google published HBM
        "fname": "Roofline_TPU.png",
        "note": "Peak = bf16 (FP32 peak not published). Matmul is FP32.",
    },
}

for name, d in devices.items():
    fig, ax = plt.subplots(figsize=(7, 5))
    x = np.logspace(-0.5, 3.5, 400)
    peak = d["peak_compute"]
    bw = d["bw_measured"]
    roof = np.minimum(peak, bw * x)
    ax.loglog(x, roof, "k-", lw=2, label=f"Roof: peak {peak:,.0f} GFLOPS; {d['bw_label']}")
    if d["bw_ref"]:
        ax.loglog(x, np.minimum(peak, d["bw_ref"] * x), "k--", lw=1.2,
                  label=f"Published bandwidth {d['bw_ref']:.0f} GB/s")
    ax.axhline(peak, color="gray", ls=":", lw=1)
    ax.plot(ai, d["achieved"], "o-", color="tab:red", ms=7, label="Measured matmul (FP32)")
    for a, g, n in zip(ai, d["achieved"], sizes):
        ax.annotate(f"n={n}", (a, g), textcoords="offset points", xytext=(6, -12), fontsize=8)
    ax.set_xlabel("Arithmetic intensity (FLOP per byte)")
    ax.set_ylabel("Performance (GFLOP/s)")
    ax.set_title(f"Roofline: {name}")
    ax.grid(True, which="both", ls=":", alpha=0.5)
    ax.legend(fontsize=8, loc="upper left")
    fig.text(0.01, 0.01, d["note"] + " AI = n/6 (FP32 matmul).", fontsize=8, color="#444")
    fig.tight_layout(rect=(0, 0.03, 1, 1))
    fig.savefig(f"/mnt/user-data/outputs/{d['fname']}", dpi=160)
    plt.close(fig)
    print("saved", d["fname"])
